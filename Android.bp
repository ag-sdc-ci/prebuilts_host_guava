package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_import {
    name: "guava",
    jars: ["lib64/guava.jar"],
    host_supported: true,
}

java_import {
    name: "guava-both",
    jars: ["lib64/guava-both.jar"],
    host_supported: true,
}

java_import {
    name: "guava-jre",
    jars: ["lib64/guava-jre.jar"],
    host_supported: true,
}

java_import {
    name: "guava-testlib",
    jars: ["lib64/guava-testlib.jar"],
    host_supported: true,
}

java_import {
    name: "guava-android-host",
    jars: ["lib64/guava-android-host.jar"],
    host_supported: true,
}

java_import {
    name: "guava-android-annotation-stubs",
    jars: ["lib64/guava-android-annotation-stubs.jar"],
    host_supported: true,
}

java_import {
    name: "guava-android-testlib-host",
    jars: ["lib64/guava-android-testlib-host.jar"],
    host_supported: true,
}
